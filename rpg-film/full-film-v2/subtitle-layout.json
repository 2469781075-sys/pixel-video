  "sentences": [
    {
      "sentence": 1,
      "font_size": 66,
      "lines": [
        "不知道大家的中学生活是怎么样的？"
      ],
      "measured_line_widths": [
        736.0
      ],
      "panel_box": [
        80,
        950,
        1840,
        1060
      ],
      "text_anchor": [
